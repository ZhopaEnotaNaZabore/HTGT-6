# Publish source, resources and build tooling only.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/README.md
!/readmeENG
!/build.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/gradle/
!/src/
!/tools/
!/scripts/

# Generated binaries, caches, IDE state and local configuration.
**/__pycache__/
**/.gradle*/
**/.idea/
**/.settings/
**/build/
**/out/
**/bin/
**/libs/
**/embedded-libs/
**/run/
**/locals/
**/local/
*.class
*.pyc
*.jar
*.zip
*.tar
*.gz
*.log
*.tmp
*.bak
*.iml
*.ipr
*.iws
.env
.env.*
local.properties
*.key
*.pem
*.p12
*.pfx
*.jks
!gradle/wrapper/gradle-wrapper.jar

# Local decompilation references and task handoffs.
/tools/decompile1202/
/tools/handoff/
/tools/concepts/
/tools/*-task.txt

# Scripts tied to private workstation paths.
/tools/sync_server_config70.py
/tools/Audit-ExternalSounds177.ps1
/tools/Pack-TieredHullTextures.ps1
/tools/Pack-IndustrialCrusherTextures.ps1
